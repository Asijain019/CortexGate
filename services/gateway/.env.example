PORT=3003

# ---------------------------------------------------------------- providers
# A provider is used only when configured (key present). Order = tie-break / fallback order.
PROVIDER_ORDER=groq,openrouter,nvidia,gemini,cerebras,cloudflare,cohere,sambanova,mistral,huggingface,github,ollama

# Per provider: <P>_MODEL = standard tier, <P>_MODEL_LIGHT / <P>_MODEL_HEAVY override the other tiers.
# <P>_RR_WEIGHT (default 1) = weighted round-robin share among equally ranked providers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_LIGHT=openai/gpt-oss-20b
GROQ_MODEL_HEAVY=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
# Tried inside the same attempt on 429/503; comma list allowed
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL_LIGHT=liquid/lfm-3-1.7b:free
OPENROUTER_MODEL_HEAVY=openrouter/free

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=gpt-oss-120b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B

# Cerebras (free tier)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Cloudflare Workers AI (free daily allocation): needs token AND account id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# Cohere (trial key, OpenAI-compatibility endpoint)
COHERE_API_KEY=
COHERE_MODEL=command-r7b-12-2024

# Ollama (local, no key). Enabled when OLLAMA_BASE_URL is set or OLLAMA_ENABLED=true.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_ENABLED=true
OLLAMA_MODEL=qwen2.5:0.5b
# Per-attempt timeout for Ollama only (CPU inference is slow)
OLLAMA_TIMEOUT_MS=30000

# ---------------------------------------------------------------- routing
# cost | balanced | quality (per request: body routing_policy or header x-routing-policy)
ROUTING_POLICY=balanced
# Classifier score thresholds: < LIGHT_MAX -> light, >= HEAVY_MIN -> heavy
ROUTER_LIGHT_MAX=0.3
ROUTER_HEAVY_MIN=0.6
# Providers whose score is within this of the best are rotated round robin
RR_BUCKET_DELTA=0.05

# ---------------------------------------------------------------- failover
PROVIDER_TIMEOUT_MS=10000
REQUEST_BUDGET_MS=30000
PROVIDER_MAX_RETRIES=0
PROVIDER_MAX_INFLIGHT=8
RATE_LIMIT_COOLDOWN_MS=30000
AUTH_COOLDOWN_MS=600000
BAD_RESPONSE_COOLDOWN_MS=300000
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_MS=20000
# Cache-verification calls: max provider attempts
VERIFY_MAX_ATTEMPTS=2

# ---------------------------------------------------------------- gateway rate limit (Redis token bucket)
REDIS_URL=redis://localhost:6380
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_TOKENS=1000
RATE_LIMIT_WINDOW_SEC=60

# ---------------------------------------------------------------- storage
MONGODB_URI=mongodb://127.0.0.1:27017/cortexgate
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------- semantic cache
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_TASK_TYPE=SEMANTIC_SIMILARITY
CACHE_THRESHOLD=0.92
CACHE_VERIFY=true
CACHE_TRUST_ABOVE=0.985
CACHE_TTL_MS=86400000
